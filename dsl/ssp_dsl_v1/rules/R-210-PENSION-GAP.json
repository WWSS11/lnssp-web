{
  "dsl_version": "SSP-DSL-1.0",
  "rule_id": "R-210-PENSION-GAP",
  "name": "计算养老缴费年限缺口（以月计）",
  "module": "pension",
  "status": "published",
  "priority": 210,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "gap_years_ceil 仅用于展示；实际补缴/续缴按月规划。",
  "inputs": [
    {
      "key": "user.social.pension_contrib_months",
      "type": "number",
      "required": true,
      "desc": "养老累计缴费月数"
    },
    {
      "key": "calc.pension.min_years_required",
      "type": "number",
      "required": true,
      "desc": "最低养老缴费年限(年)"
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_missing",
        "when": {
          "or": [
            {
              "==": [
                {
                  "var": "user.social.pension_contrib_months"
                },
                null
              ]
            },
            {
              "==": [
                {
                  "var": "calc.pension.min_years_required"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-PENSION-MONTHS",
                "text": "请提供养老累计缴费月数（可从辽宁人社公共服务平台、电子社保卡或参保地经办渠道查询）。",
                "field": "user.social.pension_contrib_months"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_compute",
        "when": {
          "and": [
            {
              "!=": [
                {
                  "var": "user.social.pension_contrib_months"
                },
                null
              ]
            },
            {
              "!=": [
                {
                  "var": "calc.pension.min_years_required"
                },
                null
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.pension.gap_months",
              "value": {
                "max": [
                  0,
                  {
                    "-": [
                      {
                        "*": [
                          {
                            "var": "calc.pension.min_years_required"
                          },
                          12
                        ]
                      },
                      {
                        "var": "user.social.pension_contrib_months"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "set",
              "path": "calc.pension.gap_years_ceil",
              "value": {
                "ceil": [
                  {
                    "/": [
                      {
                        "var": "calc.pension.gap_months"
                      },
                      12
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.pension.gap_months",
      "type": "number"
    },
    {
      "key": "calc.pension.gap_years_ceil",
      "type": "number"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "已缴14年(168月)，要求15年(180月) -> 缺12月",
      "input": {
        "user": {
          "social": {
            "pension_contrib_months": 168
          }
        },
        "calc": {
          "pension": {
            "min_years_required": 15
          }
        }
      },
      "expected": {
        "calc": {
          "pension": {
            "gap_months": 12,
            "gap_years_ceil": 1
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "source": "全国人民代表大会常务委员会",
      "document_no": "全国人大常委会决定（2024年9月13日通过）",
      "url": "https://www.npc.gov.cn/npc/c2/kgfb/202409/t20240913_439534.html",
      "effective_from": "2025-01-01",
      "effective_to": null,
      "reviewed_at": "2026-08-20",
      "note": "养老缴费年限初步缺口按最低缴费年限与已确认累计缴费月数之差计算"
    }
  ]
}
