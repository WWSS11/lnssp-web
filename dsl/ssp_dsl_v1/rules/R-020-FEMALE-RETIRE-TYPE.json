{
  "dsl_version": "SSP-DSL-1.0",
  "rule_id": "R-020-FEMALE-RETIRE-TYPE",
  "name": "女性原法定退休年龄口径确认",
  "module": "retirement",
  "status": "published",
  "priority": 20,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "",
  "inputs": [
    {
      "key": "user.basic.gender",
      "type": "string",
      "required": true,
      "desc": "male/female"
    },
    {
      "key": "user.basic.female_retire_type",
      "type": "string",
      "required": false,
      "desc": "仅女性使用：worker50=原50周岁口径，cadre55=原55周岁口径，unknown=暂不确定"
    }
  ],
  "parameter_refs": [],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_male_set_na",
        "when": {
          "==": [
            {
              "var": "user.basic.gender"
            },
            "male"
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.retirement.female_retire_type_status",
              "value": "unconfirmed"
            },
            {
              "type": "set",
              "path": "user.basic.female_retire_type",
              "value": "na"
            }
          ]
        }
      },
      {
        "row_id": "row_2_female_known",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.basic.gender"
                },
                "female"
              ]
            },
            {
              "in": [
                {
                  "var": "user.basic.female_retire_type"
                },
                [
                  "worker50",
                  "cadre55"
                ]
              ]
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.retirement.female_retire_type_status",
              "value": "confirmed"
            }
          ]
        }
      },
      {
        "row_id": "row_3_female_unknown",
        "when": {
          "and": [
            {
              "==": [
                {
                  "var": "user.basic.gender"
                },
                "female"
              ]
            },
            {
              "!": {
                "in": [
                  {
                    "var": "user.basic.female_retire_type"
                  },
                  [
                    "worker50",
                    "cadre55"
                  ]
                ]
              }
            }
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-FEMALE-RETIRE-TYPE",
                "text": "请确认适用的女性原法定退休年龄口径：原50周岁或原55周岁。应以个人档案、岗位性质、参保身份及经办认定为准；不能确认时请选择暂不确定。",
                "field": "user.basic.female_retire_type"
              }
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "user.basic.female_retire_type",
      "type": "string"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "女性未填口径 -> 追问",
      "input": {
        "user": {
          "basic": {
            "gender": "female",
            "female_retire_type": null
          }
        }
      },
      "expected": {
        "calc": {
          "needs_agent": true
        }
      }
    },
    {
      "name": "男性 -> na",
      "input": {
        "user": {
          "basic": {
            "gender": "male"
          }
        }
      },
      "expected": {
        "user": {
          "basic": {
            "female_retire_type": "na"
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "source": "全国人民代表大会常务委员会",
      "document_no": "全国人大常委会决定（2024年9月13日通过）",
      "url": "https://www.npc.gov.cn/npc/c2/kgfb/202409/t20240913_439534.html",
      "effective_from": "2025-01-01",
      "effective_to": null,
      "reviewed_at": "2026-08-20",
      "note": "延迟退休对照表区分原法定退休年龄50周岁和55周岁的女职工；具体个人口径仍由档案和经办认定"
    }
  ]
}
