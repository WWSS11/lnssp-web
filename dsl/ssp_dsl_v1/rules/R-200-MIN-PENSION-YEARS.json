{
  "dsl_version": "SSP-DSL-1.0",
  "rule_id": "R-200-MIN-PENSION-YEARS",
  "name": "按退休年份查最低养老缴费年限（参数时间线）",
  "module": "pension",
  "status": "published",
  "priority": 200,
  "effective_from": "2024-01-01",
  "effective_to": null,
  "supersedes": [],
  "notes": "该时间线为可配置参数：如政策调整，只需在 Admin 中新增版本/修正 rows，无需改代码。",
  "inputs": [
    {
      "key": "calc.retirement.minimum_contribution_reference_year",
      "type": "number",
      "required": true
    }
  ],
  "parameter_refs": [
    {
      "param_id": "T-MIN-PENSION-YEARS-BY-RETIRE-YEAR",
      "purpose": "最低缴费年限时间线"
    }
  ],
  "decision_table": {
    "hit_policy": "first",
    "rows": [
      {
        "row_id": "row_1_missing",
        "when": {
          "==": [
            {
              "var": "calc.retirement.minimum_contribution_reference_year"
            },
            null
          ]
        },
        "then": {
          "actions": [
            {
              "type": "set",
              "path": "calc.needs_agent",
              "value": true
            },
            {
              "type": "emit_question",
              "value": {
                "question_id": "Q-RETIRE-YEAR",
                "text": "缺少退休年份，无法判断最低缴费年限（15/16/…/20年）。",
                "field": "calc.retirement.minimum_contribution_reference_year"
              }
            }
          ]
        }
      },
      {
        "row_id": "row_2_lookup",
        "when": {
          "!=": [
            {
              "var": "calc.retirement.minimum_contribution_reference_year"
            },
            null
          ]
        },
        "then": {
          "actions": [
            {
              "type": "lookup",
              "table_param_id": "T-MIN-PENSION-YEARS-BY-RETIRE-YEAR",
              "key": {
                "retire_year": {
                  "var": "calc.retirement.minimum_contribution_reference_year"
                }
              },
              "into": "calc.pension.min_years_required"
            }
          ]
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "calc.pension.min_years_required",
      "type": "number",
      "desc": "最低养老缴费年限(年)"
    },
    {
      "key": "calc.needs_agent",
      "type": "boolean"
    },
    {
      "key": "calc.agent_questions",
      "type": "array"
    }
  ],
  "examples": [
    {
      "name": "退休年份2029 -> 15年",
      "input": {
        "calc": {
          "retirement": {
            "minimum_contribution_reference_year": 2029
          }
        }
      },
      "expected": {
        "calc": {
          "pension": {
            "min_years_required": 15
          }
        }
      }
    },
    {
      "name": "退休年份2036 -> 18.5年",
      "input": {
        "calc": {
          "retirement": {
            "minimum_contribution_reference_year": 2036
          }
        }
      },
      "expected": {
        "calc": {
          "pension": {
            "min_years_required": 18.5
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "source": "全国人民代表大会常务委员会",
      "document_no": "全国人大常委会决定（2024年9月13日通过）",
      "url": "https://www.npc.gov.cn/npc/c2/kgfb/202409/t20240913_439534.html",
      "effective_from": "2025-01-01",
      "effective_to": null,
      "reviewed_at": "2026-08-20",
      "note": "2030年起最低缴费年限每年提高6个月，2039年达到20年"
    },
    {
      "source": "人力资源和社会保障部等三部门",
      "document_no": "人社部发〔2024〕94号",
      "url": "https://www.mohrss.gov.cn/wap/zc/zcwj/202501/t20250101_533701.html",
      "effective_from": "2025-01-01",
      "effective_to": null,
      "reviewed_at": "2026-08-20",
      "note": "弹性提前退休按所选择退休时间对应年份核验最低缴费年限；弹性延迟按法定退休年龄对应年份核验"
    }
  ]
}
